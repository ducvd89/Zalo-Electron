{
  "name": "fbmess",
  "productName": "FB Messenger",
  "version": "1.1.2",
  "description": "Facebook Messenger desktop app built with Electron",
  "main": "main.js",
  "homepage": "https://www.messenger.com",
  "author": {
    "name": "Duc Vu",
    "email": "ducvd89@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ducvd.fbmess",
    "productName": "FB Messenger",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "files": [
      "main.js",
      "error.html",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["pacman"],
      "icon": "assets/icon.png",
      "category": "Network;InstantMessaging",
      "maintainer": "Duc Vu <ducvd89@gmail.com>",
      "synopsis": "Facebook Messenger for Linux",
      "desktop": {
        "StartupWMClass": "FB Messenger"
      }
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    }
  }
}
