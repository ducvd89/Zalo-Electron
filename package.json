{
  "name": "zaloweb",
  "productName": "Zalo Web",
  "version": "1.0.0",
  "description": "Ứng dụng Zalo cho máy tính (bản web chat.zalo.me), xây dựng bằng Electron",
  "main": "main.js",
  "homepage": "https://chat.zalo.me",
  "author": {
    "name": "Duc Vu",
    "email": "ducvd89@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ducvd.zaloweb",
    "productName": "Zalo Web",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "compression": "normal",
    "files": [
      "main.js",
      "error.html",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "target": ["pacman"],
      "icon": "assets/icon.png",
      "category": "Network;InstantMessaging",
      "maintainer": "Duc Vu <ducvd89@gmail.com>",
      "synopsis": "Zalo Web cho Linux",
      "desktop": {
        "StartupWMClass": "Zalo Web"
      }
    },
    "mac": {
      "target": ["dmg"],
      "icon": "assets/icon.png",
      "category": "public.app-category.social-networking"
    }
  }
}
